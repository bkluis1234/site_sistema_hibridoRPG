# Nunca usar credenciais de produção em testes. Codifique caracteres especiais na URL.
DATABASE_URL="mysql://hibrido:troque-esta-senha@127.0.0.1:3306/hibrido"
APP_ORIGIN="http://localhost:5173"
NODE_ENV="development"
PORT=3000
# Reverse proxy único do Render; avalie a topologia antes de modificar.
TRUST_PROXY=0
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET="substitua-por-ao-menos-32-caracteres-aleatorios"
# Somente para Compose local. Substitua; não reutilize em produção.
MYSQL_PASSWORD="troque-esta-senha"
MYSQL_ROOT_PASSWORD="troque-a-senha-root-local"
# Produção: true obrigatório; CA opcional conforme provedor.
DATABASE_SSL=false
# DATABASE_CA_PATH="/etc/secrets/mysql-ca.pem"

# Limite da prévia de retrato; envio persistente aguarda storage externo.
PORTRAIT_MAX_BYTES=5242880
